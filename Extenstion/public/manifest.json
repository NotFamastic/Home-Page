{
  "name": "Home Page",
  "description": "Base Level Extension",
  "version": "1.0.0.Alpha",
  "manifest_version": 3,
  "action": {
    "default_popup": "Html/Extenstion_Default.html"
  },

  "background": {
    "service_worker": "handler.js"
  },

  "chrome_settings_overrides": {
    "newtab": "../index.html",
    "startup_pages": ["https://www.startup.com"]
  },
  "default_locale": "de",
  "permissions": ["activeTab", "scripting", "tabs", "history", "alarms"],
  "host_permissions": ["https://zenquotes.io/*"]
}
