{
    "name": "Home Page",
    "description": "Base Level Extension",
    "version": "Dev-1.0",
    "manifest_version": 3,
    "action": {
    "default_popup": "default.html"
  },
    "background": {
        "service_worker": "handler.js"
  },
  "permissions": ["activeTab","scripting","tabs","history","alarms"],
  "host_permissions": ["https://example.com/*"]
}